{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "Household Bills",
    "version":  "1.0.3",
    "identifier":  "com.householdbills.desktop",
    "build":  {
                  "beforeDevCommand":  "npm run dev:frontend",
                  "devUrl":  "http://127.0.0.1:1420",
                  "beforeBuildCommand":  "npm run build:frontend",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "label":  "main",
                                    "title":  "Household Bills",
                                    "width":  1540,
                                    "height":  980,
                                    "minWidth":  1180,
                                    "minHeight":  760,
                                    "center":  true,
                                    "resizable":  true,
                                    "fullscreen":  false
                                }
                            ],
                "security":  {
                                 "csp":  "default-src \u0027self\u0027; img-src \u0027self\u0027 asset: http://asset.localhost data:; style-src \u0027self\u0027 \u0027unsafe-inline\u0027; connect-src ipc: http://ipc.localhost http://127.0.0.1:*;"
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "nsis"
                               ],
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.ico"
                            ],
                   "windows":  {
                                   "nsis":  {
                                                "displayLanguageSelector":  false,
                                                "installerIcon":  "icons/icon.ico",
                                                "installMode":  "currentUser",
                                                "startMenuFolder":  "Household Bills",
                                                "uninstallerIcon":  "icons/icon.ico"
                                            },
                                   "webviewInstallMode":  {
                                                              "type":  "downloadBootstrapper",
                                                              "silent":  true
                                                          }
                               },
                   "publisher":  "Household Bills",
                   "shortDescription":  "Local household bill and paycheck planner",
                   "longDescription":  "A private, local Windows application that plans household bills around paycheck schedules and tracks payments, balances, savings, debt, and backups.",
                   "copyright":  "Copyright © 2026 Household Bills",
                   "createUpdaterArtifacts":  true
               },
    "plugins":  {
                    "updater":  {
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJFMEFFQ0M5OEI4NDQxNDIKUldSQ1FZU0x5ZXdLTGg4dU5oRXdsRm9oL2VkeThhQjFscGFqTjBpMFRpa0N6aDRJRXRRS2s4YlIK",
                                    "endpoints":  [
                                                      "https://github.com/countryboysplay/household-bills/releases/latest/download/latest.json"
                                                  ],
                                    "windows":  {
                                                    "installMode":  "passive"
                                                }
                                }
                }
}